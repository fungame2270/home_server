appConfig:
  theme: glass
  language: en
pageInfo:
  title: Victal Home Server
  description: Welcome Victal how are you today?
sections:
  - name: Arr-Stack
    icon: 'fas fa-film '
    items:
      - title: Jellyfin
        description: The Media Server
        icon: hl-jellyfin
        url: http://jellyfin.{{ my_domain }}
        target: newtab
      - title: Radarr
        description: Movie Manager
        icon: hl-radarr
        url: http://radarr.{{ my_domain }}
        target: newtab
      - title: Sonarr
        description: Series Manager
        icon: hl-Sonarr
        url: http://sonarr.{{ my_domain }}
        target: newtab
      - title: Prowlarr
        description: Indexer ArrStack
        icon: hl-prowlarr
        target: newtab
        url: http://prowlarr.{{ my_domain }}
      - title: seerr
        icon: hl-seerr
        target: newtab
        url: http://seerr.{{ my_domain }}
      - title: Transmission
        description: Torrent Client
        icon: hl-transmission
        target: newtab
        url: http://transmission.{{ my_domain }}
  - name: Network
    icon: 'fa fa-globe '
    items:
      - title: Ad Guard
        description: Dns server and blocker
        icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/webp/adguard-home.webp
        target: newtab
        url: http://adguard.{{ my_domain }}
      - title: Caddy
        description: Reverse Proxy
        icon: hl-caddy
        url: oww
        target: newtab
  - name: Proxmox Cluster
    icon: si-proxmox
    widgets:
      - type: proxmox-lists
        useProxy: true
        options:
          cluster_url: http://192.168.30.176:8006
          user_name: {{ proxmox_dashy_token_user_id }}
          token_name: {{ proxmox_dashy_token_name }}
          token_uuid: {{ proxmox_dashy_token_uuid }}
          allowInsecure: true
          node: pve
          node_data: lxc
          title: Proxmox LXCs
          title_as_link: true
          hide_templates: 1
pages: []
